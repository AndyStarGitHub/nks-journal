<odoo>
  <data>
    <template id="report_partner_journal">
      <t t-call="web.html_container">
        <main>
          <t t-call="web.external_layout">
            <div class="page">
              <t t-set="partner" t-value="docs and docs[0] or False"/>

              <h2>
                Specialist Journal — <span t-esc="partner and partner.name or ''"/>
              </h2>

              <t t-if="partner">
                <t t-set="entries"
                   t-value="env['specialist.journal.entry'].search([('partner_id', '=', partner.id)], order='date desc, id desc')"/>

                <t t-if="not entries">
                  <p>No journal entries.</p>
                </t>

                <t t-if="entries">
                  <table class="table table-sm o_main_table">
                    <thead>
                      <tr>
                        <th>Date</th>
                        <th>Specialist</th>
                        <th>Type</th>
                        <th>Title</th>
                      </tr>
                    </thead>
                    <tbody>
                      <t t-foreach="entries" t-as="e">
                        <tr>
                          <td><span t-esc="e.date"/></td>
                          <td><span t-esc="e.user_id.name"/></td>
                          <td><span t-esc="dict(e._fields['entry_type'].selection).get(e.entry_type)"/></td>
                          <td><span t-esc="e.name"/></td>
                        </tr>
                        <tr>
                          <td colspan="4" style="white-space: pre-wrap; padding-bottom: 10px;">
                            <span t-esc="e.content"/>
                          </td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </t>
              </t>

            </div>
          </t>
        </main>
      </t>
    </template>

  </data>
</odoo>
