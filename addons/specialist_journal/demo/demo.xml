<odoo>
  <data noupdate="1">

    <record id="demo_user_spec01" model="res.users">
      <field name="name">Spec 01</field>
      <field name="login">spec01@nks.com.ua</field>

      <field name="password">spec01</field>

      <field name="groups_id" eval="[
        (4, ref('base.group_user')),
        (4, ref('specialist_journal.group_specialist_journal_user'))
      ]"/>
    </record>

    <record id="demo_user_spec02" model="res.users">
      <field name="name">Spec 02</field>
      <field name="login">spec02@nks.com.ua</field>
      <field name="password">spec02</field>

      <field name="groups_id" eval="[
        (4, ref('base.group_user')),
        (4, ref('specialist_journal.group_specialist_journal_user'))
      ]"/>
    </record>

    <record id="demo_partner_howe_steve" model="res.partner">
      <field name="name">Howe Steve</field>
    </record>

    <record id="demo_template_consultation" model="specialist.journal.template">
      <field name="name">Consultation (Demo)</field>
      <field name="entry_type">consultation</field>
      <field name="body">Subjective:\nObjective:\nAssessment:\nPlan:</field>
    </record>

    <record id="demo_template_follow_up" model="specialist.journal.template">
      <field name="name">Follow-up (Demo)</field>
      <field name="entry_type">follow_up</field>
      <field name="body">Progress:\nWhat changed:\nNext steps:</field>
    </record>

    <record id="demo_entry_1" model="specialist.journal.entry">
      <field name="partner_id" ref="demo_partner_howe_steve"/>
      <field name="user_id" ref="demo_user_spec01"/>
      <field name="entry_type">consultation</field>
      <field name="name">Initial consultation</field>
      <field name="content">Demo note by Spec 01</field>
    </record>

    <record id="demo_entry_2" model="specialist.journal.entry">
      <field name="partner_id" ref="demo_partner_howe_steve"/>
      <field name="user_id" ref="demo_user_spec02"/>
      <field name="entry_type">follow_up</field>
      <field name="name">Follow-up</field>
      <field name="content">Demo note by Spec 02</field>
    </record>

  </data>
</odoo>
