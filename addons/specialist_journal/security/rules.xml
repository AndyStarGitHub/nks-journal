<odoo>
    <data noupdate="1">

    <record id="rule_entry_user_read_all" model="ir.rule">
      <field name="name">Specialist Journal Entry - user read all</field>
      <field name="model_id" ref="model_specialist_journal_entry"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="groups" eval="[(4, ref('specialist_journal.group_specialist_journal_user'))]"/>
      <field name="perm_read" eval="1"/>
      <field name="perm_write" eval="0"/>
      <field name="perm_create" eval="0"/>
      <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rule_entry_user_write_own" model="ir.rule">
      <field name="name">Specialist Journal Entry - user write own</field>
      <field name="model_id" ref="model_specialist_journal_entry"/>
      <field name="domain_force">[('user_id','=',user.id)]</field>
      <field name="groups" eval="[(4, ref('specialist_journal.group_specialist_journal_user'))]"/>
      <field name="perm_read" eval="0"/>
      <field name="perm_write" eval="1"/>
      <field name="perm_create" eval="1"/>
      <field name="perm_unlink" eval="1"/>
    </record>

        <record id="rule_journal_entry_admin_all_read" model="ir.rule">
            <field name="name">Journal entries: admin - all (read)</field>
            <field name="model_id" ref="model_specialist_journal_entry"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('specialist_journal.group_specialist_journal_admin'))]"/>
        </record>

    </data>
</odoo>
